<div class="col">
  <article class="card h-100 product-card shadow-sm">
    <div class="product-art" aria-hidden="true">✦</div>
    <div class="card-body d-flex flex-column">
      <div class="text-uppercase small text-muted"><%= product.brand.name %> · <%= product.category.name %></div>
      <h3 class="h5 mt-2"><%= link_to product.name, product_path(product), class: "stretched-link text-decoration-none text-dark" %></h3>
      <p class="small text-muted"><%= truncate(product.description, length: 90) %></p>
      <div class="mt-auto d-flex justify-content-between"><strong><%= number_to_currency(product.price, unit: "$", precision: 2) %></strong><span>★ <%= product.rating %></span></div>
    </div>
  </article>
</div>
