<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for(:title) || "Beauty Product Explorer" %></title>
    <%= yield :head %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark beauty-nav" aria-label="Primary">
      <div class="container">
        <%= link_to "✦ Beauty Product Explorer", root_path, class: "navbar-brand fw-bold" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primary-navigation" aria-controls="primary-navigation" aria-expanded="false" aria-label="Toggle primary navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="primary-navigation">
          <div class="navbar-nav ms-auto">
            <%= link_to "Products", products_path, class: "nav-link text-white" %>
            <%= link_to "Categories", categories_path, class: "nav-link text-white" %>
            <%= link_to "Brands", brands_path, class: "nav-link text-white" %>
            <%= link_to "About", about_path, class: "nav-link text-white" %>
          </div>
        </div>
      </div>
    </nav>
    <main class="container py-5"><%= yield %></main>
    <footer class="container py-4 border-top text-muted small">Beauty Product Explorer · Rails Intro Project · Educational sample data</footer>
    <%= javascript_include_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js", crossorigin: "anonymous" %>
  </body>
</html>
