<h1>Shop by category</h1><p class="text-muted">Choose a category to browse its products.</p>
<div class="row g-3 mt-2"><% @categories.each do |category| %>
  <div class="col-md-4"><div class="card h-100 p-4"><h2 class="h4"><%= link_to category.name, category_path(category) %></h2><p><%= category.description %></p><span class="text-muted small"><%= category.products.count %> products</span></div></div>
<% end %></div>
